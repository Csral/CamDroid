#include <windows.h>
1 ICON "camdroid.ico"
#ifndef APP_DESCRIPTION
#define APP_DESCRIPTION "CamDroid Uninstaller"
#endif
#ifndef APP_FILENAME
#define APP_FILENAME "CamDroid-Uninstall.exe"
#endif
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Csral"
            VALUE "FileDescription", APP_DESCRIPTION
            VALUE "FileVersion", "1.0"
            VALUE "ProductName", "CamDroid"
            VALUE "ProductVersion", "1.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Csral"
            VALUE "OriginalFilename", APP_FILENAME
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
