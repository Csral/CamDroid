# Add project specific R8 rules here.
# JNI looks up these constructors and methods by their unmangled names.
-keep class csral.camdroid.TransportBridge { *; }
-keep class csral.camdroid.IncomingPacket { *; }
-keep class csral.camdroid.NativeBridge { *; }
-keep class csral.camdroid.NativeResponse { *; }
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

